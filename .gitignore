# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# Environment variables
.env
.env.*

# ML tracking and checkpoints
mlruns/
.pytest_cache/
.ruff_cache/

# DVC and Data/Models
# Data and models directories are tracked by DVC, not Git
/data/raw/*.csv
/data/processed/
/models/*.joblib
/models/*.pkl
/models/*.onnx

# Allow gitkeep files and dvc tracking files
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/models/.gitkeep
!*.dvc
!/data/.gitignore
!.dvcignore
